---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-6">
            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
                  Categories
                </label>
                <select
                  id="category-filter"
                  multiple
                  size={Math.min(Math.max(categories.length, 3), 6)}
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="category-filter"
                  aria-describedby="filter-help"
                >
                  {categories.map((category) => (
                    <option value={category.id}>{category.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
                  Publisher
                </label>
                <select
                  id="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                  aria-describedby="filter-help"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>
            </div>
            <p id="filter-help" class="mt-3 text-sm text-slate-400">
              Select one or more categories and a publisher to narrow the games.
            </p>
            <div class="mt-4 flex items-center justify-between gap-4">
              <p id="filter-result-count" data-testid="filter-result-count" class="text-sm text-slate-300" role="status" aria-live="polite">
                Showing {games.length} games
              </p>
              <button
                type="button"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-testid="filterable-game"
                data-category-id={game.category?.id ?? ''}
                data-publisher-id={game.publisher?.id ?? ''}
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const gameCards = [...document.querySelectorAll<HTMLElement>('[data-testid="filterable-game"]')];
  const resultCount = document.querySelector<HTMLElement>('#filter-result-count');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  function applyFilters(): void {
    if (!categoryFilter || !publisherFilter || !resultCount || !emptyState) return;

    const selectedCategories = new Set(
      [...categoryFilter.selectedOptions].map((option) => option.value),
    );
    const selectedPublisher = publisherFilter.value;
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    resultCount.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    emptyState.classList.toggle('hidden', visibleCount !== 0);
  }

  categoryFilter?.addEventListener('change', applyFilters);
  publisherFilter?.addEventListener('change', applyFilters);
  clearFilters?.addEventListener('click', () => {
    if (!categoryFilter || !publisherFilter) return;
    for (const option of categoryFilter.options) option.selected = false;
    publisherFilter.value = '';
    applyFilters();
  });
</script>
